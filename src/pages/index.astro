                ></path>
              </svg>
              <span>Escríbeme por WhatsApp</span>
            </a>
          </p>
          <div class="calendly-wrap">
            <h3 class="calendly-heading">
              O elige fecha y hora en el calendario:
            </h3>
            <iframe
              src="https://calendly.com/berbelnajasjj/30min?hide_landing_page_details=1&hide_gdpr_banner=1&background_color=f7f3ee&text_color=16092b&primary_color=b0166f"
              width="100%"
              height="1120"
              title="Reserva tu cita con Carmen en Calendly"
              class="calendly-frame"
              loading="lazy"></iframe>
          </div>
          <div class="hand-figure-flow">
            <Image
              src={handButterflyImg}
              alt="Mano abierta con mariposa en vuelo de NeoCrisálida"
              class="hand-original-img"
              loading="lazy"
              decoding="async"
            />
          </div>
        </div>
      </section>
    </main>

    <footer class="stage stage-7 colophon-stage">
      <div class="shell">
        <p class="colophon">
          NeoCrisálida — Carmen. Acompañamiento psicológico y emocional online.
        </p>
      </div>
    </footer>
